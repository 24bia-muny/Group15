import java.util.ArrayList;
import java.util.Scanner;

public class Exercise11_StudentList {
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        ArrayList<String> students=new ArrayList<>();
        int c;
        do{
            System.out.println("\n1.Add 2.Remove 3.View 4.Search 5.Count 6.Exit");
            System.out.print("Choice: "); c=sc.nextInt(); sc.nextLine();
            switch(c){
                case 1 -> { System.out.print("Name: "); students.add(sc.nextLine()); }
                case 2 -> { System.out.print("Name: "); students.remove(sc.nextLine()); }
                case 3 -> { for(int i=0;i<students.size();i++) System.out.println((i+1)+". "+students.get(i)); }
                case 4 -> { System.out.print("Name: "); String n=sc.nextLine();
                           System.out.println(students.contains(n) ? "Found at "+(students.indexOf(n)+1) : "Not found"); }
                case 5 -> System.out.println("Total: "+students.size());
                case 6 -> System.out.println("Exiting..."); 
                default -> System.out.println("Invalid choice");
            }
        }while(c!=6);
        sc.close();
    }
}
