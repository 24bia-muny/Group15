import java.util.Scanner;
import java.util.Random;

public class NumberGuessingGame {
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        Random r=new Random();
        int num=r.nextInt(100)+1, guess=0, attempts=0;
        System.out.println("Guess my number (1-100):");
        while(guess!=num){
            System.out.print("Your guess: "); guess=sc.nextInt(); attempts++;
            if(guess<num) System.out.println("Too low!");
            else if(guess>num) System.out.println("Too high!");
            else{
                System.out.println("🎉 Correct! Attempts: "+attempts);
                System.out.println("Rating: "+(attempts<=5?"Excellent":attempts<=10?"Good job!":"Keep trying"));
            }
        }
        sc.close();
    }
}
