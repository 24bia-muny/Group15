public class Employee {
    private String id;
    private String name;
    private String dept;
    private double salary;
    private int years;

    public Employee(){ id=name="Unknown"; dept="None"; salary=500000; years=0; }
    public Employee(String i,String n,String d,double s){ id=i; name=n; dept=d; setSalary(s); years=0; }

    public void setSalary(double s){ if(s>=500000) salary=s; }
    public void setYears(int y){ if(y>=0) years=y; }
    public void promote(String d,double inc){ dept=d; salary+=inc; }

    public double bonus(){ return salary*Math.min(years*0.1,0.5); }
    public double net(){ return salary+bonus()-(salary+bonus())*0.15; }

    public void display(){ System.out.println(id+" "+name+" "+dept+" Salary:"+salary+" Bonus:"+bonus()+" Net:"+net()); }

    public static void main(String[] args){
        Employee emp1=new Employee("EMP001","Ali Hassan","IT",1500000);
        Employee emp2=new Employee("EMP002","Fatma Said","HR",1200000);
        emp1.setYears(5);
        emp2.setYears(2);

        emp1.display(); 
        emp2.display();
        emp1.promote("Senior IT",300000);
        System.out.println("After promotion:"); emp1.display();
        
        
    }
}

